MONGODB_URL=mongodb://localhost:27017/real-estate-management
MODEL_PATH=./models/plot_price_model.joblib

# --- Training mode ---
# development = Mongo + optional synthetic seed (local bootstrap)
# production  = Mongo / export CSV only; synthetic seed blocked
TRAINING_MODE=development

# Local dev only — set false in production / for TL demo with real data
TRAINING_USE_SEED_CSV=true
TRAINING_USE_MONGO=true

# Optional: extra CSV (e.g. export from Mongo)
# TRAINING_CSV=./data/plots_production_export.csv

# Minimum Sold plots required when TRAINING_MODE=production
TRAINING_MIN_SOLD_ROWS=5
